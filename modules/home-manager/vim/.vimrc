syntax on

set ai smartindent
set hlsearch
set number
set paste
set ruler
set smartcase
set showmatch
set wildmenu
set wildmode=list:full

set background=dark
set clipboard=unnamed,unnamedplus

set laststatus=2
set statusline=%<%f\ %m%r%h%w%{'['.(&fenc!=''?&fenc:&enc).']['.&ff.']'}%=%l,%c%V%8P

set ts=2
set sts=2
set sw=2
set expandtab

set nobk
set nocp
set noswapfile
set nowrap
